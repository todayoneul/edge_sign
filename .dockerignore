# Docker 빌드 컨텍스트 슬림화 — 추론에 필요한 자원만 포함.
.git
**/__pycache__/
*.pyc
*.pyo

# 프론트 빌드 컨텍스트 — 빌더 스테이지가 npm ci로 깨끗이 설치/빌드하므로 제외
web_modern/node_modules/
web_modern/dist/

# 대용량 원본 데이터/학습 산출물
AIhub/
checkpoints/
runs/
logs/
assets/
data/demo_videos/
data/yolo_signs_v2/
data/aihub_traffic/
data/aihub_signboard/
data/korean_ocr/
data/GTSDB/
data/**/*.faiss
*.pt
*.tar
*.zip

# model_space: A/B·추론에 필요한 ONNX만 포함 (나머지 44MB×N 제외)
model_space/*.onnx
!model_space/yolov8s_signs_v3_fp32.onnx
!model_space/yolov8s_signs_v3_int8_static.onnx
!model_space/korean_ocr_net_w8a8.onnx
!model_space/korean_sign_net_fp32.onnx
# 온디바이스(브라우저) WebGPU용 fp16 검출기 — scripts/export_fp16_detector.py 로 생성 필요
!model_space/yolov8s_signs_v3_fp16.onnx
